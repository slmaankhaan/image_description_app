# Copy this file to .env and fill in your own values.

# Required unless USE_FAKE_VISION=true below.
ANTHROPIC_API_KEY=

PORT=3000
DATABASE_PATH=data/app.db
UPLOAD_DIR=data/uploads
MAX_FILE_SIZE_BYTES=10485760

# Uncomment to run the app without an Anthropic API key (uses a fake vision client
# that returns a canned description instead of calling the real API).
# USE_FAKE_VISION=true
